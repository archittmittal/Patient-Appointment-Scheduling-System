# ============================================================
# Patient Appointment Scheduling System — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------
# Server
# ------------------------------------
PORT=7860
# NODE_ENV options: development | production | test
NODE_ENV=development

# ------------------------------------
# Database (MySQL / TiDB)
# ------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_strong_db_password_here
DB_NAME=hospital_system
# MySQL default is 3306; TiDB Cloud uses 4000
DB_PORT=3306
# Set to "true" to enforce TLS/SSL on the DB connection (recommended in production)
DB_SSL=false

# ------------------------------------
# Authentication (JWT)
# ------------------------------------
# Must be at minimum 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_minimum_32_char_random_secret
# Token lifetime (e.g. 8h, 1d, 7d)
JWT_EXPIRES_IN=8h
# bcrypt work factor — 10–12 is a safe range (higher = slower but more secure)
BCRYPT_ROUNDS=10

# ------------------------------------
# Payments (Stripe)
# ------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Obtain from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------
# Google OAuth
# ------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here

# ------------------------------------
# Notification Services (all optional)
# ------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------
# Email (SMTP / Nodemailer)
# ------------------------------------
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your_app_specific_password

# ------------------------------------
# Application URLs
# ------------------------------------
APP_URL=http://localhost:7860
FRONTEND_URL=http://localhost:5173

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------
# Rate Limiting (optional overrides)
# ------------------------------------
# Window in minutes for the global API rate limiter (default: 15)
RATE_LIMIT_WINDOW_MINS=15
# Max requests per IP per window (default: 100)
RATE_LIMIT_MAX=100

# ------------------------------------
# Performance / Observability
# ------------------------------------
# Queries slower than this threshold (ms) will emit a WARN log (default: 100)
SLOW_QUERY_THRESHOLD_MS=100
# Database connection pool maximum size (default: 100)
DB_CONNECTION_LIMIT=100

# Redis Cache connection (optional health monitoring)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# ------------------------------------
# Demo Credentials (seeded by: npm run db:seed)
# ------------------------------------
# Patient : patient@example.com   / password123
# Doctor  : dr.sarah@hospital.com / password123
# Admin   : admin@hospital.com    / admin123
