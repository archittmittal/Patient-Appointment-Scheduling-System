{
  "name": "patient-appointment-scheduling-system",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "load-test:dry": "bash load-tests/run-dry-run.sh",
    "load-test:full": "k6 run load-tests/k6/full-profile.js"
  },
  "devDependencies": {
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "backend/src/**/*.js": [
      "npm run test --workspace=backend -- --bail --findRelatedTests"
    ],
    "frontend/src/**/*.{js,jsx}": [
      "npx eslint --config frontend/eslint.config.js --fix",
      "npx vitest related --run --root frontend"
    ]
  },
  "engines": {
    "node": "20.x"
  }
}
