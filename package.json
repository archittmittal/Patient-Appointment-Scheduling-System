{
  "name": "patient-appointment-scheduling-system",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "backend/src/**/*.js": [
      "npm run test --workspace=backend -- --bail --findRelatedTests"
    ],
    "frontend/src/**/*.{js,jsx}": [
      "npx eslint --config frontend/eslint.config.js --fix",
      "npm run test --workspace=frontend -- --related"
    ]
  },
  "engines": {
    "node": "20.x"
  }
}
